; Velocity Rush 3D — Godot 4.7.2
; مشروع سباق ثلاثي الأبعاد غير متصل، قابل للتصدير إلى Android وWeb.
config_version=5

[application]
config/name="Velocity Rush 3D"
config/description="لعبة سباق ثلاثية الأبعاد أصلية تعمل دون اتصال بالإنترنت."
config/version="1.0.0"
run/main_scene="res://scenes/race/race_main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icons/app_icon.png"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.027, 0.047, 0.078, 1)

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[physics]
3d/default_gravity=9.8
common/physics_ticks_per_second=60

[audio]
default_bus_layout="res://default_bus_layout.tres"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.027, 0.047, 0.078, 1)
